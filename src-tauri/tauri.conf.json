{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "trajetve",
  "version": "0.1.0",
  "identifier": "fr.jaouendekerlede.trajetve",
  "build": {
    "frontendDist": "https://jaouendekerlede.github.io/trajetve/",
    "devUrl": "http://localhost:8766",
    "beforeDevCommand": "python -m http.server 8766"
  },
  "app": {
    "windows": [
      {
        "title": "Trajet VE",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
